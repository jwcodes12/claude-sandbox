[Unit]
Description=Overnight Studio nightly build pipeline
After=network-online.target studio-votes.service
Wants=network-online.target

[Service]
Type=oneshot
User=studio
Group=studio
WorkingDirectory=/home/studio
# Auth: studio's own ~/.claude/.credentials.json (refreshes itself).
ExecStart=/home/studio/bin/nightly.sh
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/studio /srv/studio
