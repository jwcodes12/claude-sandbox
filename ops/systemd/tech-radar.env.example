# Copy to ~/.config/claude-sandbox/tech-radar.env on the OCI box.

TECH_RADAR_DATA_DIR=/home/opc/.local/state/claude-sandbox/tech-radar
TECH_RADAR_DEPLOY_PROVIDER=vercel

# Tech Twitter is ingested directly from the local newsboat cache.db (the curated
# list feed + all followed accounts), so no Twitter/RSS bridge URLs are needed.
# Set TECH_RADAR_TWITTER=false to disable the Twitter source.
TECH_RADAR_TWITTER=true
# Optional: override the newsboat cache path (defaults to ~/.newsboat/cache.db).
NEWSBOAT_CACHE_DB=

# Optional model briefs. Deterministic fallback briefs work without these.
TECH_RADAR_ENABLE_LLM=0
TECH_RADAR_WRITER_PROVIDER=codex
TECH_RADAR_EDITOR_PROVIDER=claude
TECH_RADAR_ENABLE_EDITOR=1
TECH_RADAR_MAX_MODEL_BRIEFS=12
# Provider-specific CLI model pins. TECH_RADAR_CLI_MODEL is kept only as a
# backward-compatible fallback when a provider-specific value is empty.
TECH_RADAR_CODEX_MODEL=gpt-5.5
TECH_RADAR_CLAUDE_MODEL=claude-opus-4-8
TECH_RADAR_CLAUDE_FALLBACK_MODEL=claude-sonnet-4-6
TECH_RADAR_AGY_WRITER_MODEL="Gemini 3.5 Flash (Medium)"
TECH_RADAR_AGY_EDITOR_MODEL="Gemini 3.5 Flash (High)"
TECH_RADAR_CLI_MODEL=
# Legacy single-stage provider. Leave empty unless intentionally overriding.
TECH_RADAR_MODEL_PROVIDER=
TECH_RADAR_SMALL_MODEL=claude-haiku-4-5
TECH_RADAR_LARGE_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Netlify deploy.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Vercel deploy.
VERCEL_TOKEN=
VERCEL_SCOPE=
