# Copy to ~/.config/claude-sandbox/tech-radar.env on the OCI box.

TECH_RADAR_DATA_DIR=/home/opc/.local/state/claude-sandbox/tech-radar
TECH_RADAR_DEPLOY_PROVIDER=netlify

# Add your Twitter/RSS bridge URLs.
TWITTER_TECH_LIST_RSS=
TWITTER_AI_WATCH_RSS=

# Optional model briefs. Deterministic fallback briefs work without these.
TECH_RADAR_ENABLE_LLM=0
TECH_RADAR_MODEL_PROVIDER=anthropic
TECH_RADAR_SMALL_MODEL=claude-3-5-haiku-latest
TECH_RADAR_LARGE_MODEL=claude-opus-4-1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Netlify deploy.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Vercel deploy fallback.
VERCEL_TOKEN=
