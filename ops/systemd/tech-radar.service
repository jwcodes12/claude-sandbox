[Unit]
Description=Claude Sandbox Tech Radar worker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/claude-sandbox
EnvironmentFile=%h/.config/claude-sandbox/tech-radar.env
# Homebrew bin (npm/netlify/node) and ~/.local/bin (claude/codex CLIs) must be on
# PATH; the systemd user-service environment is otherwise minimal.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/linuxbrew/.linuxbrew/bin/npm run run:deploy -w @claude-sandbox/tech-radar
LockPersonality=yes
NoNewPrivileges=yes
