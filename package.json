{
  "name": "claude-sandbox",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @claude-sandbox/agi-markets",
    "dev:agi-markets": "npm run dev -w @claude-sandbox/agi-markets",
    "dev:tech-radar": "npm run dev -w @claude-sandbox/tech-radar",
    "build": "npm run build --workspaces --if-present",
    "build:agi-markets": "npm run build -w @claude-sandbox/agi-markets",
    "build:tech-radar": "npm run build -w @claude-sandbox/tech-radar",
    "lint": "npm run lint --workspaces --if-present",
    "lint:agi-markets": "npm run lint -w @claude-sandbox/agi-markets",
    "check:tech-radar": "npm run check -w @claude-sandbox/tech-radar"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
